{
  "name": "mcp-tmux",
  "version": "0.1.0",
  "description": "MCP server: persistent tmux-backed shell sessions for AI agents \u2014 interactive commands, REPLs, ssh, dev servers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-tmux": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "npm run build && node dist/test/smoke.js",
    "prepare": "tsc",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tmux",
    "terminal",
    "shell",
    "repl",
    "agent",
    "claude",
    "llm"
  ],
  "author": "Cuong Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuonghuunguyen/tmux-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cuonghuunguyen/tmux-mcp/issues"
  },
  "homepage": "https://github.com/cuonghuunguyen/tmux-mcp#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "freebsd",
    "openbsd",
    "netbsd",
    "sunos",
    "aix"
  ]
}
